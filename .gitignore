# ---- Data: raw datasets are never committed (DATA.md §4) ----
data/raw/*
!data/raw/.gitkeep
data/**/*.parquet
data/**/*.feather
data/**/*.arrow
data/**/*.h5
data/**/*.hdf5
data/**/*.sqlite
data/**/*.db
data/**/*.csv
data/**/*.csv.gz
data/**/*.zip
data/**/*.tar
data/**/*.tar.gz
data/**/*.npy
data/processed/graph_cache/
# large technical smoke-test circuits (real ids, no biological claim); perf report stays tracked
data/circuits/smoke_technical_*_min*.json
# simulation snapshots can be large; reports stay tracked
data/simulations/*.snapshot.json

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
build/
dist/

# ---- Environment / secrets ----
.env
.env.*
!.env.example

# ---- Node / frontend ----
node_modules/
frontend/dist/
frontend/dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Playwright ----
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/playwright/.cache/

# ---- Editors / OS ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
